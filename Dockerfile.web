FROM node:22-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable
WORKDIR /app

FROM base AS builder

COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @factumation/contracts build \
  && pnpm --filter @factumation/domain build \
  && pnpm --filter @factumation/web build

FROM node:22-alpine AS runner

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 --ingroup nodejs factumation

COPY --from=builder --chown=factumation:nodejs /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=factumation:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=factumation:nodejs /app/apps/web/.next/static ./apps/web/.next/static

USER factumation
EXPOSE 3000

CMD ["node", "apps/web/server.js"]
