{
  "name": "factumation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite",
    "dev:legacy": "vite",
    "dev:web": "pnpm --filter @factumation/web dev",
    "dev:api": "pnpm --filter @factumation/api dev",
    "build": "vite build && node scripts/prerender.mjs",
    "build:web": "pnpm --filter @factumation/web build",
    "build:api": "pnpm --filter @factumation/api build",
    "build:workspaces": "pnpm --filter @factumation/* --if-present build",
    "preview": "vite preview",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "lint": "eslint . --max-warnings 48",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:node && pnpm typecheck:workspaces",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:workspaces": "pnpm --filter @factumation/contracts build && pnpm --filter @factumation/domain build && pnpm --filter @factumation/* --if-present typecheck",
    "typecheck:edge": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "test": "pnpm test:legacy && pnpm test:workspaces",
    "test:legacy": "vitest run tests",
    "test:workspaces": "pnpm --filter @factumation/* --if-present test",
    "test:watch": "vitest tests",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:workspaces",
    "remotion:studio": "npx remotion studio remotion/index.ts",
    "remotion:render": "npx remotion render remotion/index.ts",
    "remotion:render:promo": "npx remotion render remotion/index.ts FactumationPromo out/promo.mp4",
    "remotion:render:features": "npx remotion render remotion/index.ts FactumationFeatures out/features.mp4",
    "remotion:render:features-connected": "npx remotion render remotion/index.ts FactumationFeaturesConnected out/features-connected.mp4",
    "remotion:render:demo": "npx remotion render remotion/index.ts FactumationDemo out/demo.mp4"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@remotion/cli": "4.0.410",
    "@remotion/tailwind": "^4.0.410",
    "@remotion/transitions": "^4.0.410",
    "@supabase/supabase-js": "^2.90.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.73.1",
    "react-router-dom": "^7.9.6",
    "remotion": "4.0.410",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/html2pdf.js": "^0.10.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.8",
    "puppeteer": "^24.36.0",
    "supabase": "2.117.0",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.0",
    "vitest": "^5.0.1"
  }
}
